# Copy to .env for local development. Never commit the real .env.
# On Vercel, set these in Project Settings -> Environment Variables instead.

# Postgres connection string.
# Vercel/Neon: use the POOLED connection string (host contains "-pooler"),
# otherwise serverless functions will exhaust the connection limit.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Direct (non-pooled) connection, used only by `prisma migrate` at build time.
# Neon/Supabase provide this alongside the pooled URL. If your provider has no
# separate direct URL, set this to the same value as DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Secret used to sign session JWTs. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=""

# Google OAuth credentials — https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs must include BOTH:
#   http://localhost:3000/api/auth/google/callback
#   https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
